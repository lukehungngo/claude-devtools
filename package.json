{
  "name": "@lukehungngo/claude-devtools",
  "version": "0.3.15",
  "description": "Live observability, turn-by-turn traces, and usage insights for Claude Code",
  "bin": {
    "claude-devtools": "dist/cli.cjs"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "lint": "eslint server/src/ dashboard/src/ && pnpm --dir dashboard lint:styles",
